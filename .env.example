# ==============================================================================
# Real-Time Fleet Operations Platform Environment Configuration
# ==============================================================================

# Node Environment
NODE_ENV=development
LOG_LEVEL=info

# API Service
API_PORT=3000
API_HOST=0.0.0.0
CORS_ORIGIN=http://localhost:5173

# Worker Service
WORKER_HEALTH_PORT=3001
WORKER_CONCURRENCY=5

# Web Service
WEB_PORT=5173
VITE_API_BASE_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# Database - MongoDB
# ------------------------------------------------------------------------------
# Option A: Local MongoDB (Docker or local instance)
MONGO_URL=mongodb://localhost:27017/fleet_ops
# MONGO_URI is also supported as an alias

# Option B: MongoDB Atlas (Cloud)
# MONGO_URL=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/fleet_ops?retryWrites=true&w=majority

MONGO_DATABASE=fleet_ops

# ------------------------------------------------------------------------------
# Cache & Queues - Redis
# ------------------------------------------------------------------------------
# Option A: Local Redis (Docker or local instance)
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# Option B: Upstash Redis (Cloud TLS / rediss://)
# Uncomment REDIS_URL to use Upstash or any cloud Redis URI (overrides REDIS_HOST/PORT):
# REDIS_URL=rediss://default:<password>@<endpoint>.upstash.io:6379

# ------------------------------------------------------------------------------
# Fleet Engine Settings
# ------------------------------------------------------------------------------
STALE_DEVICE_THRESHOLD_SECONDS=60
METRIC_ANOMALY_CPU_PERCENT=90
METRIC_ANOMALY_MEMORY_PERCENT=90
