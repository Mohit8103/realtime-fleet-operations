{
  "name": "fleet-operations-platform",
  "version": "1.0.0",
  "description": "Real-Time Operations Platform for Device Fleet Monitoring",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "dev": "concurrently -k -p \"[{name}]\" -n \"api,worker,web\" -c \"cyan,magenta,green\" \"npm run dev:api\" \"npm run dev:worker\" \"npm run dev:web\"",
    "dev:api": "npm run dev --workspace=@fleet/api",
    "dev:worker": "npm run dev --workspace=@fleet/worker",
    "dev:web": "npm run dev --workspace=@fleet/web",
    "dev:simulator": "npm run dev --workspace=@fleet/simulator",
    "simulate": "tsx apps/simulator/src/index.ts",
    "demo:normal": "tsx apps/simulator/src/index.ts --devices 3 --rate 1",
    "demo:offline": "tsx apps/simulator/src/index.ts --devices 3 --rate 1 --offline-after 20 --offline-for 90 --anomaly-rate 0.1 --anomaly-device 1",
    "demo:burst": "tsx apps/simulator/src/index.ts --devices 1 --rate 1 --burst 300",
    "demo:chaos": "tsx apps/simulator/src/index.ts --devices 5 --rate 1 --duplicate-rate 0.05 --out-of-order-rate 0.05 --malformed-rate 0.02 --anomaly-rate 0.1 --offline-after 20 --offline-for 30",
    "build": "npm run build --workspaces --if-present",
    "prepare": "npm run build",
    "seed": "tsx scripts/seed.ts",
    "reset-data": "tsx scripts/reset-data.ts",
    "test": "tsx scripts/run-all-tests.ts",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "test:acceptance": "node test-acceptance.mjs",
    "test:phase2": "tsx test-phase2.mjs",
    "test:phase3": "tsx test-phase3.mjs",
    "test:phase4": "tsx test-phase4.mjs",
    "docker:up": "docker compose up --build",
    "docker:down": "docker compose down -v",
    "docker:logs": "docker compose logs -f"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "concurrently": "^10.0.6",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  }
}
